<section class="tab pdvf-tab-body pdvf-grid-main {{tab.cssClass}}" data-group="primary" data-tab="combat">
  <div class="pdvf-col-left">
    <section>
      <h2 class="pdvf-h2"><i class="pdvf-lozenge" aria-hidden="true"></i>{{localize "PDVF.Section.Health"}}</h2>
      <div class="pdvf-derived">
        <span class="pdvf-derived-label">{{localize "PDVF.Derived.majorWound.label"}}</span>
        <span class="pdvf-derived-value">{{system.derived.majorWound}}</span>
      </div>
      <div class="pdvf-derived">
        <span class="pdvf-derived-label">{{localize "PDVF.Derived.knockdown.label"}}</span>
        <span class="pdvf-derived-value">{{system.derived.knockdown}}</span>
      </div>
      <div class="pdvf-derived">
        <span class="pdvf-derived-label">{{localize "PDVF.Derived.unconscious.label"}}</span>
        <span class="pdvf-derived-value">{{system.derived.unconscious}}</span>
      </div>
      <label class="pdvf-derived">
        <span class="pdvf-derived-label">{{localize "PDVF.Health.aggravation"}}</span>
        <input type="number" class="pdvf-row-input" name="system.health.aggravation" value="{{system.health.aggravation}}" step="1" min="0">
      </label>
      <label class="pdvf-derived">
        <span class="pdvf-derived-label">{{localize "PDVF.Health.deterioration"}}</span>
        <input type="number" class="pdvf-row-input" name="system.health.deterioration" value="{{system.health.deterioration}}" step="1" min="0">
      </label>
      <div class="pdvf-combat-state">
        <button type="button" class="pdvf-state-btn {{#if combat.mounted}}on{{/if}}" data-action="combatMount" aria-pressed="{{#if combat.mounted}}true{{else}}false{{/if}}"
          data-tooltip="{{#if combat.horseName}}{{combat.horseName}}{{#if combat.horseCharge}} · {{localize 'PDVF.Horse.ChargeShort'}} {{combat.horseCharge}}{{/if}}{{else}}{{localize 'PDVF.Combat.NoMainHorse'}}{{/if}}">
          <i class="fa-solid fa-horse" aria-hidden="true"></i> {{#if combat.mounted}}{{localize "PDVF.Status.mounted"}}{{else}}{{localize "PDVF.Combat.OnFoot"}}{{/if}}</button>
        {{#if combat.prone}}<button type="button" class="pdvf-state-btn warn" data-action="combatStand"><i class="fa-solid fa-person-arrow-up-from-line" aria-hidden="true"></i> {{localize "PDVF.Combat.StandUp"}}</button>{{/if}}
        {{#if combat.disarmed}}<button type="button" class="pdvf-state-btn warn" data-action="combatRearm"><i class="fa-solid fa-hand" aria-hidden="true"></i> {{localize "PDVF.Combat.Rearm"}}</button>{{/if}}
        {{#if combat.unconscious}}<span class="pdvf-state-badge">{{localize "PDVF.Combat.UnconsciousBadge"}}</span>{{/if}}
        {{#if combat.dying}}<span class="pdvf-state-badge dying">{{localize "PDVF.Combat.DyingBadge"}}</span>{{/if}}
      </div>
      <div class="pdvf-checks">
        <label><input type="checkbox" name="system.health.debilitated" {{checked system.health.debilitated}}> {{localize "PDVF.Health.debilitated"}}</label>
        <label><input type="checkbox" name="system.health.melancholy" {{checked system.health.melancholy}}> {{localize "PDVF.Health.melancholy"}}</label>
        <label><input type="checkbox" name="system.health.madness" {{checked system.health.madness}}> {{localize "PDVF.Health.madness"}}</label>
      </div>
      {{#if combat.cold}}<p class="pdvf-hint pdvf-hazard-note"><i class="fa-solid fa-snowflake" aria-hidden="true"></i> {{combat.coldLine}}</p>{{/if}}
      {{#if combat.poisonCon}}<p class="pdvf-hint pdvf-hazard-note"><i class="fa-solid fa-skull-crossbones" aria-hidden="true"></i> {{combat.poisonLine}}</p>{{/if}}
      <h3 class="pdvf-h3">{{localize "PDVF.Combat.Wounds"}}{{#if combat.total}} <small>{{combat.total}}</small>{{/if}}</h3>
      {{#if combat.wounds.length}}
      <ul class="pdvf-wounds">
        {{#each combat.wounds}}
        <li class="{{type}} {{#if aided}}aided{{/if}}">
          <strong class="pdvf-wound-dmg">{{damage}}</strong>
          <span class="pdvf-wound-type">{{typeLabel}}</span>
          <span class="pdvf-wound-src">{{source}}</span>
          {{#if aided}}<span class="pdvf-gear-tag" data-tooltip="{{localize 'PDVF.Combat.AidedTip'}}"><i class="fa-solid fa-check" aria-hidden="true"></i></span>
          {{else}}<button type="button" class="pdvf-gear-test" data-action="woundAid" data-id="{{id}}"><i class="fa-solid fa-kit-medical" aria-hidden="true"></i> {{localize "PDVF.Combat.FirstAid"}}</button>{{/if}}
          {{#if @root.editMode}}<button type="button" class="pdvf-icon-btn" data-action="woundDelete" data-index="{{index}}" aria-label="{{localize 'PDVF.Sheet.Delete'}}"><i class="fa-solid fa-xmark"></i></button>{{/if}}
        </li>
        {{/each}}
      </ul>
      {{else}}
      <p class="pdvf-hint">{{localize "PDVF.Combat.NoWounds"}}</p>
      {{/if}}
      <div class="pdvf-combat-actions">
        <button type="button" class="pdvf-btn" data-action="combatDamage"><i class="fa-solid fa-droplet" aria-hidden="true"></i> {{localize "PDVF.Combat.Receive"}}</button>
        <button type="button" class="pdvf-btn" data-action="combatHazard" data-tooltip="{{localize 'PDVF.Hazard.ButtonTip'}}"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> {{localize "PDVF.Hazard.Button"}}</button>
        <button type="button" class="pdvf-btn" data-action="combatWeek"><i class="fa-solid fa-bed" aria-hidden="true"></i> {{localize "PDVF.Combat.Week"}}</button>
        <button type="button" class="pdvf-btn" data-action="combatAggravate" data-tooltip="{{localize 'PDVF.Combat.AggravateTip'}}"><i class="fa-solid fa-heart-crack" aria-hidden="true"></i> {{localize "PDVF.Combat.Aggravate"}}</button>
      </div>
    </section>

    <section class="pdvf-gear-section">
      <h2 class="pdvf-h2"><i class="pdvf-lozenge" aria-hidden="true"></i>{{localize "PDVF.Gear.ArmorSection"}}</h2>
      <div class="pdvf-armor-total">
        <span><span class="pdvf-derived-label">{{localize "PDVF.Gear.ArmorPoints"}}</span> <strong>{{gear.armor}}</strong></span>
        <span><span class="pdvf-derived-label">{{localize "PDVF.Gear.ShieldPoints"}}</span> <strong>{{gear.shield}}</strong></span>
      </div>
      {{#if gear.virtue}}
      <ul class="pdvf-armor-list">
        <li class="pdvf-virtue-armor" data-tooltip="{{localize 'PDVF.Ideal.VirtueArmorTip'}}">
          <span class="pdvf-icon-btn pdvf-equip on" aria-hidden="true"><i class="fa-solid fa-sun"></i></span>
          <span class="pdvf-gear-icon" aria-hidden="true"></span>
          <span class="pdvf-link">{{localize "PDVF.Ideal.VirtueArmor"}}</span>
          <span class="pdvf-gear-tag">{{localize "PDVF.Ideal.courteous.name"}}</span>
          <span class="pdvf-armor-value">{{gear.virtue}}</span>
        </li>
      </ul>
      {{/if}}
      {{#if gear.pieces.length}}
      <ul class="pdvf-armor-list">
        {{#each gear.pieces}}
        <li class="{{#unless equipped}}stowed{{/unless}} {{#if ignored}}ignored{{/if}}">
          <button type="button" class="pdvf-icon-btn pdvf-equip {{#if equipped}}on{{/if}}" data-action="gearEquip" data-id="{{id}}"
            aria-pressed="{{#if equipped}}true{{else}}false{{/if}}" data-tooltip="{{#if equipped}}{{localize 'PDVF.Gear.Unequip'}}{{else}}{{localize 'PDVF.Gear.Equip'}}{{/if}}"
            aria-label="{{localize 'PDVF.Gear.Equipped'}}"><i class="fa-solid {{#if equipped}}fa-shirt{{else}}fa-box-archive{{/if}}"></i></button>
          <img src="{{img}}" alt="" class="pdvf-gear-icon">
          <button type="button" class="pdvf-link" data-action="gearOpen" data-id="{{id}}" {{#if tip}}data-tooltip="{{tip}}"{{/if}}>{{name}}</button>
          <span class="pdvf-gear-tag">{{detail}}</span>
          <span class="pdvf-armor-value">{{#if isShield}}<i class="fa-solid fa-shield-halved" aria-hidden="true"></i> {{/if}}{{value}}</span>
          {{#if @root.editMode}}<button type="button" class="pdvf-icon-btn" data-action="gearDelete" data-id="{{id}}" aria-label="{{localize 'PDVF.Sheet.Delete'}}"><i class="fa-solid fa-xmark"></i></button>{{/if}}
        </li>
        {{/each}}
      </ul>
      {{/if}}
      {{#each gear.warnings}}<p class="pdvf-warn">{{this}}</p>{{/each}}
      {{#each gear.notes}}<p class="pdvf-hint">{{this}}</p>{{/each}}
      {{#unless gear.hasGear}}
      <p class="pdvf-hint">{{localize "PDVF.Gear.DropHint"}}</p>
      {{#if editable}}<button type="button" class="pdvf-btn" data-action="startingGear"><i class="fa-solid fa-chess-knight" aria-hidden="true"></i> {{localize "PDVF.Gear.StartingButton"}}</button>{{/if}}
      {{/unless}}
    </section>
  </div>
  <div class="pdvf-col-right">
    <section>
      <h2 class="pdvf-h2"><i class="pdvf-lozenge" aria-hidden="true"></i>{{localize "PDVF.Section.Attacks"}}</h2>
      <div class="pdvf-derived">
        <span class="pdvf-derived-label">{{localize "PDVF.Derived.damage.label"}}</span>
        <span class="pdvf-derived-value">{{system.derived.damage}}</span>
      </div>
      <div class="pdvf-derived">
        <span class="pdvf-derived-label">{{localize "PDVF.Derived.brawlDamage.label"}}</span>
        <span class="pdvf-derived-value">{{system.derived.brawlDamage}}</span>
      </div>
      <button type="button" class="pdvf-choose pdvf-engage-main" data-action="engage" data-tooltip="{{localize 'PDVF.Combat.EngageTip'}}"><i class="fa-solid fa-swords" aria-hidden="true"></i> {{localize "PDVF.Combat.EngageTarget"}}</button>
    </section>

    <section class="pdvf-gear-section">
      <h2 class="pdvf-h2"><i class="pdvf-lozenge" aria-hidden="true"></i>{{localize "PDVF.Gear.Weapons"}}</h2>
      {{#if gear.weapons.length}}
      <ul class="pdvf-weapons">
        {{#each gear.weapons}}
        <li class="pdvf-weapon {{#unless equipped}}stowed{{/unless}}">
          <div class="pdvf-weapon-head">
            <button type="button" class="pdvf-icon-btn pdvf-equip {{#if equipped}}on{{/if}}" data-action="gearEquip" data-id="{{id}}"
              aria-pressed="{{#if equipped}}true{{else}}false{{/if}}" data-tooltip="{{#if equipped}}{{localize 'PDVF.Gear.Unequip'}}{{else}}{{localize 'PDVF.Gear.Equip'}}{{/if}}"
              aria-label="{{localize 'PDVF.Gear.Equipped'}}"><i class="fa-solid {{#if equipped}}fa-hand-fist{{else}}fa-box-archive{{/if}}"></i></button>
            <img src="{{img}}" alt="" class="pdvf-gear-icon">
            <button type="button" class="pdvf-link pdvf-weapon-name" data-action="gearOpen" data-id="{{id}}" {{#if tip}}data-tooltip="{{tip}}"{{/if}}>{{name}}{{#if multiple}} ×{{quantity}}{{/if}}</button>
            {{#if parry}}<span class="pdvf-gear-tag" data-tooltip="{{localize 'PDVF.Gear.Parry'}}">{{localize "PDVF.Gear.ParryShort"}} +{{parry}}</span>{{/if}}
            {{#if @root.editMode}}<button type="button" class="pdvf-icon-btn" data-action="gearDelete" data-id="{{id}}" aria-label="{{localize 'PDVF.Sheet.Delete'}}"><i class="fa-solid fa-xmark"></i></button>{{/if}}
          </div>
          {{#each profiles}}
          <div class="pdvf-weapon-profile">
            {{#if modeLabel}}<span class="pdvf-weapon-mode">{{modeLabel}}</span>{{/if}}
            <button type="button" class="pdvf-gear-test" data-action="gearRoll" data-id="{{../id}}" data-mode="{{mode}}"
              data-tooltip="{{localize 'PDVF.Gear.TestTip'}}"><i class="fa-solid fa-dice-d20" aria-hidden="true"></i> {{skillLabel}} <strong>{{skillValue}}</strong></button>
            <button type="button" class="pdvf-gear-dmg {{#if missing}}missing{{/if}}" data-action="gearDamage" data-id="{{../id}}" data-mode="{{mode}}"
              data-tooltip="{{localize 'PDVF.Gear.DamageTip'}}"><i class="fa-solid fa-burst" aria-hidden="true"></i> {{label}}</button>
            {{#each alts}}
            <button type="button" class="pdvf-gear-dmg alt" data-action="gearDamage" data-id="{{../../id}}" data-mode="{{../mode}}" data-alt="{{@index}}"
              data-tooltip="{{label}}">{{damage}} <small>{{label}}</small></button>
            {{/each}}
            {{#if rangeLabel}}<span class="pdvf-gear-tag">{{rangeLabel}}</span>{{/if}}
            <button type="button" class="pdvf-gear-engage" data-action="engage" data-id="{{../id}}" data-mode="{{mode}}" data-tooltip="{{localize 'PDVF.Combat.EngageWithTip'}}" aria-label="{{localize 'PDVF.Combat.EngageTarget'}}"><i class="fa-solid fa-swords"></i></button>
          </div>
          {{/each}}
        </li>
        {{/each}}
      </ul>
      {{else}}
      <p class="pdvf-hint">{{localize "PDVF.Gear.NoWeapons"}}</p>
      {{/if}}
    </section>
  </div>
</section>
