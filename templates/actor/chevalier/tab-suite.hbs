<section class="tab pdvf-tab-body {{tab.cssClass}}" data-group="primary" data-tab="suite">
  <h2 class="pdvf-h2"><i class="pdvf-lozenge" aria-hidden="true"></i>{{localize "PDVF.Suite.Title"}}
    {{#if canCreateActors}}<button type="button" class="pdvf-btn pdvf-h2-btn" data-action="newSquire"><i class="fa-solid fa-dice-d20" aria-hidden="true"></i> {{localize "PDVF.Npc.NewSquire"}}</button>{{/if}}
  </h2>

  <div class="pdvf-followers">
    {{#each followers}}
    <div class="pdvf-follower {{#if missing}}missing{{/if}}">
      {{#if missing}}
      <span class="pdvf-follower-name">{{name}}</span>
      {{else}}
      <img class="pdvf-follower-img" src="{{img}}" alt="">
      <div class="pdvf-follower-main">
        <button type="button" class="pdvf-follower-name pdvf-plain" data-action="openFollower" data-uuid="{{uuid}}">{{name}}</button>
        <div class="pdvf-follower-meta">
          <span>{{category}}{{#if first}} · {{localize "PDVF.Npc.FirstSquire"}}{{/if}}</span>
          {{#if age}}<span>{{localize "PDVF.Npc.AgeShort"}} {{age}}</span>{{/if}}
          <span>{{localize "PDVF.Health.hp"}} {{hp}}</span>
          {{#if tooOld}}<span class="pdvf-warn-text">{{localize "PDVF.Npc.TooOld"}}</span>{{/if}}
        </div>
      </div>
      {{#if squireSkill}}
      <button type="button" class="pdvf-follower-roll" data-action="rollFollower" data-uuid="{{uuid}}" data-key="squire.skill" data-tooltip="{{localize 'PDVF.Suite.SquireTestTip'}}">
        <span>{{localize "PDVF.Npc.SquireSkill"}}</span><i class="pdvf-die-icon" aria-hidden="true"></i><strong>{{squireSkill}}</strong>
      </button>
      {{/if}}
      {{/if}}
      {{#if (or @root.editMode missing)}}
      <button type="button" class="pdvf-icon-btn" data-action="removeFollower" data-index="{{index}}" aria-label="{{localize 'PDVF.Suite.Remove'}}" data-tooltip="{{localize 'PDVF.Suite.Remove'}}">×</button>
      {{/if}}
    </div>
    {{/each}}
    <div class="pdvf-drop-hint">{{localize "PDVF.Suite.DropHint"}}</div>
  </div>

  <h2 class="pdvf-h2"><i class="pdvf-lozenge" aria-hidden="true"></i>{{localize "PDVF.Suite.Stable"}}
    {{#if canCreateActors}}<button type="button" class="pdvf-btn pdvf-h2-btn" data-action="newHorse"><i class="fa-solid fa-horse" aria-hidden="true"></i> {{localize "PDVF.Horse.New"}}</button>{{/if}}
  </h2>
  <div class="pdvf-followers">
    {{#each horses}}
    <div class="pdvf-follower {{#if missing}}missing{{/if}} {{#if main}}main{{/if}}">
      {{#if missing}}
      <span class="pdvf-follower-name">{{name}}</span>
      {{else}}
      <button type="button" class="pdvf-main-horse {{#if main}}on{{/if}}" data-action="setMainHorse" data-uuid="{{uuid}}" aria-pressed="{{#if main}}true{{else}}false{{/if}}" data-tooltip="{{localize 'PDVF.Horse.MainTip'}}"><i class="fa-solid fa-star" aria-hidden="true"></i><span class="pdvf-sr">{{localize "PDVF.Horse.Main"}}</span></button>
      <img class="pdvf-follower-img" src="{{img}}" alt="">
      <div class="pdvf-follower-main">
        <button type="button" class="pdvf-follower-name pdvf-plain" data-action="openFollower" data-uuid="{{uuid}}">{{name}}</button>
        <div class="pdvf-follower-meta">
          {{#if @root.editMode}}
          <select name="system.horses.{{index}}.role" aria-label="{{localize 'PDVF.Horse.RoleLabel'}}">{{#each roleChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
          {{else}}<span>{{roleLabel}}</span>{{/if}}
          <span>{{type}} · {{sex}} · {{color}}{{#if age}} · {{age}} {{localize "PDVF.Horse.Years"}}{{/if}}</span>
          <span>{{localize "PDVF.Health.hp"}} {{hp}} · {{localize "PDVF.Horse.ArmorShort"}} {{armor}} · {{localize "PDVF.Horse.MoveShort"}} {{move}}</span>
          {{#if weakened}}<span class="pdvf-warn-text">{{localize "PDVF.Horse.Weakened"}}</span>{{/if}}
          {{#if exhausted}}<span class="pdvf-warn-text">{{localize "PDVF.Horse.Exhausted"}}</span>{{/if}}
        </div>
      </div>
      {{#if charge}}
      <button type="button" class="pdvf-follower-roll" data-action="horseCharge" data-uuid="{{uuid}}" data-tooltip="{{localize 'PDVF.Horse.ChargeTip'}}">
        <span>{{localize "PDVF.Horse.ChargeShort"}}</span><i class="pdvf-die-icon" aria-hidden="true"></i><strong>{{charge}}</strong>
      </button>
      {{/if}}
      {{/if}}
      {{#if (or @root.editMode missing)}}
      <button type="button" class="pdvf-icon-btn" data-action="removeHorse" data-index="{{index}}" aria-label="{{localize 'PDVF.Suite.RemoveHorse'}}" data-tooltip="{{localize 'PDVF.Suite.RemoveHorse'}}">×</button>
      {{/if}}
    </div>
    {{/each}}
    <div class="pdvf-drop-hint">{{localize "PDVF.Suite.DropHorseHint"}}</div>
  </div>

  <h2 class="pdvf-h2"><i class="pdvf-lozenge" aria-hidden="true"></i>{{localize "PDVF.Economy.Title"}}</h2>
  <div class="pdvf-economy">
    <label class="pdvf-field"><span>{{localize "PDVF.Economy.Treasury"}} (£)</span>
      <input type="number" name="pdvfTreasury" value="{{treasury.pounds}}" step="0.25"></label>
    <div class="pdvf-field"><span>&nbsp;</span><strong class="pdvf-economy-amount">{{treasury.label}}</strong></div>
    <label class="pdvf-field"><span>{{localize "PDVF.Economy.Living"}}</span>
      <select name="system.economy.living">{{#each livingChoicesEco}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
  </div>
  <p class="pdvf-hint">{{localize "PDVF.Economy.Hint"}}</p>

  <h2 class="pdvf-h2"><i class="pdvf-lozenge" aria-hidden="true"></i>{{localize "PDVF.Suite.Domain"}}</h2>
  {{#if domains.length}}
  <ul class="pdvf-armor-list pdvf-domains">
    {{#each domains}}
    <li>
      <img src="{{img}}" alt="" class="pdvf-gear-icon">
      <button type="button" class="pdvf-link" data-action="domainOpen" data-id="{{id}}">{{name}}</button>
      <span class="pdvf-gear-tag">{{rank}} · {{tenure}}{{#if location}} · {{location}}{{/if}}</span>
      <span class="pdvf-armor-value">{{income}} £</span>
      {{#if passive}}<span class="pdvf-gear-tag">+{{passive}}</span>{{/if}}
      {{#if @root.editMode}}<button type="button" class="pdvf-icon-btn" data-action="domainDelete" data-id="{{id}}" aria-label="{{localize 'PDVF.Sheet.Delete'}}"><i class="fa-solid fa-xmark"></i></button>{{/if}}
    </li>
    {{/each}}
  </ul>
  <p class="pdvf-hint">{{localize "PDVF.Domain.Totals"}} : <strong>{{domainTotals.income}} £</strong> / {{localize "PDVF.Domain.Year"}}{{#if domainTotals.glory}} · {{localize "PDVF.Glory"}} +{{domainTotals.glory}} / {{localize "PDVF.Domain.Year"}}{{/if}}</p>
  {{else}}
  <p class="pdvf-hint">{{localize "PDVF.Domain.None"}}</p>
  {{/if}}
  {{#if editable}}<button type="button" class="pdvf-btn" data-action="domainNew"><i class="fa-solid fa-chess-rook" aria-hidden="true"></i> {{localize "PDVF.Domain.New"}}</button>{{/if}}

  <h2 class="pdvf-h2"><i class="pdvf-lozenge" aria-hidden="true"></i>{{localize "PDVF.Favor.Title"}}</h2>
  <p class="pdvf-hint">{{localize "PDVF.Favor.Totals"}} : {{localize "PDVF.Favor.due"}} F{{favorTotals.due}} · {{localize "PDVF.Favor.owed"}} F{{favorTotals.owed}}</p>
  {{#if favors.length}}
  <table class="pdvf-wiz-table compact pdvf-favors">
    <thead><tr><th scope="col">{{localize "PDVF.Favor.Direction"}}</th><th scope="col">{{localize "PDVF.Favor.Who"}}</th><th scope="col">F</th><th scope="col">{{localize "PDVF.Favor.Reason"}}</th><th scope="col">{{localize "PDVF.Domain.YearCol"}}</th><th scope="col">{{localize "PDVF.Favor.Settled"}}</th><th></th></tr></thead>
    <tbody>
      {{#each favors}}
      <tr class="{{#if settled}}settled{{/if}}">
        <td><select name="system.favors.{{index}}.direction" aria-label="{{localize 'PDVF.Favor.Direction'}}">{{#each directionChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></td>
        <td><input type="text" name="system.favors.{{index}}.who" value="{{who}}" aria-label="{{localize 'PDVF.Favor.Who'}}"></td>
        <td><input type="number" name="system.favors.{{index}}.value" value="{{value}}" min="0" step="1" aria-label="F"></td>
        <td><input type="text" name="system.favors.{{index}}.reason" value="{{reason}}" aria-label="{{localize 'PDVF.Favor.Reason'}}"></td>
        <td><input type="number" name="system.favors.{{index}}.year" value="{{year}}" step="1" aria-label="{{localize 'PDVF.Domain.Year'}}"></td>
        <td><input type="checkbox" name="system.favors.{{index}}.settled" {{checked settled}} aria-label="{{localize 'PDVF.Favor.Settled'}}"></td>
        <td><button type="button" class="pdvf-icon-btn" data-action="deleteRow" data-path="system.favors" data-index="{{index}}" aria-label="{{localize 'PDVF.Sheet.Delete'}}">×</button></td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  {{/if}}
  <div class="pdvf-combat-actions">
    <button type="button" class="pdvf-btn" data-action="addRow" data-path="system.favors" data-direction="due">{{localize "PDVF.Favor.AddDue"}}</button>
    <button type="button" class="pdvf-btn" data-action="addRow" data-path="system.favors" data-direction="owed">{{localize "PDVF.Favor.AddOwed"}}</button>
  </div>
  <p class="pdvf-hint">{{localize "PDVF.Favor.Hint"}}</p>
</section>
