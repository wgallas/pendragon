<section class="tab pdvf-tab-body pdvf-grid-traits {{tab.cssClass}}" data-group="primary" data-tab="traits">
  <div class="pdvf-traits-col">
    <h2 class="pdvf-h2"><i class="pdvf-lozenge" aria-hidden="true"></i>{{localize "PDVF.Section.Traits"}}</h2>
    <div class="pdvf-traits">
      {{#each traits}}
      <div class="pdvf-trait">
        <div class="pdvf-trait-side left {{#if left.famous}}famous{{/if}} {{#if left.virtue}}virtue{{/if}}">
          {{#if @root.editMode}}
          {{> "systems/pendragon-vf/templates/actor/chevalier/parts/stepper.hbs" name=left.inputName value=left.value min="0" label=left.label}}
          {{else}}
          <button type="button" class="pdvf-shield" data-action="roll" data-key="{{left.key}}">{{left.display}}</button>
          {{/if}}
          <input type="checkbox" class="pdvf-xp" name="{{left.xpName}}" {{checked left.xp}} aria-label="{{localize 'PDVF.Sheet.XpFor'}} {{left.label}}">
          <span class="pdvf-trait-label" {{#if left.virtue}}data-tooltip="{{localize 'PDVF.Sheet.Virtue'}}"{{/if}}>{{left.label}}</span>
        </div>
        <div class="pdvf-trait-bar" aria-hidden="true"></div>
        <div class="pdvf-trait-side right {{#if right.famous}}famous{{/if}} {{#if right.virtue}}virtue{{/if}}">
          <span class="pdvf-trait-label" {{#if right.virtue}}data-tooltip="{{localize 'PDVF.Sheet.Virtue'}}"{{/if}}>{{right.label}}</span>
          <input type="checkbox" class="pdvf-xp" name="{{right.xpName}}" {{checked right.xp}} aria-label="{{localize 'PDVF.Sheet.XpFor'}} {{right.label}}">
          {{#if @root.editMode}}
          {{> "systems/pendragon-vf/templates/actor/chevalier/parts/stepper.hbs" name=right.inputName value=right.value min="0" label=right.label}}
          {{else}}
          <button type="button" class="pdvf-shield" data-action="roll" data-key="{{right.key}}">{{right.display}}</button>
          {{/if}}
        </div>
      </div>
      {{/each}}
    </div>

    <div class="pdvf-under-traits">
      <h3 class="pdvf-h3">{{localize "PDVF.Section.DirectedTraits"}}</h3>
      {{#each directedTraits}}
      <div class="pdvf-row">
        {{#if @root.editMode}}
        <input type="text" class="pdvf-row-text" name="system.directedTraits.{{index}}.name" value="{{name}}" placeholder="{{localize 'PDVF.Sheet.DirectedPlaceholder'}}">
        {{> "systems/pendragon-vf/templates/actor/chevalier/parts/stepper.hbs" name=(concat "system.directedTraits." index ".value") value=value label=name}}
        <button type="button" class="pdvf-icon-btn" data-action="deleteRow" data-path="system.directedTraits" data-index="{{index}}" aria-label="{{localize 'PDVF.Sheet.Delete'}}">×</button>
        {{else}}
        <span class="pdvf-row-label">{{name}}</span>
        <span class="pdvf-row-value">{{numberFormat value sign=true}}</span>
        {{/if}}
      </div>
      {{else}}
      <p class="pdvf-hint">{{localize "PDVF.Sheet.NoDirected"}}</p>
      {{/each}}
      {{#if editMode}}
      <button type="button" class="pdvf-btn pdvf-add" data-action="addRow" data-path="system.directedTraits">{{localize "PDVF.Sheet.AddDirected"}}</button>
      {{/if}}
    </div>

    {{!-- Idéaux (Livre du joueur, chap. 6) et Table Ronde --}}
    <section class="pdvf-ideals">
      <h2 class="pdvf-h2"><i class="pdvf-lozenge" aria-hidden="true"></i>{{localize "PDVF.Section.Ideals"}}</h2>
      <label class="pdvf-field pdvf-ideal-pursued">
        <span>{{localize "PDVF.Ideal.Pursued"}}</span>
        <select name="system.ideal">{{#each ideals.pursuedChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
      </label>
      {{#each ideals.list}}
      <details class="pdvf-ideal state-{{state}} {{#if pursued}}pursued{{/if}} {{#unless enabled}}disabled{{/unless}}" {{#if open}}open{{/if}}>
        <summary>
          <span class="pdvf-ideal-name">{{#if pursued}}<i class="fa-solid fa-star" aria-hidden="true" data-tooltip="{{localize 'PDVF.Ideal.Pursued'}}"></i> {{/if}}{{name}}</span>
          <span class="pdvf-ideal-state">{{stateLabel}}</span>
        </summary>
        <ul class="pdvf-ideal-checks">
          {{#each checks}}
          <li class="{{#if ok}}ok{{else}}missing{{/if}}" {{#if tip}}data-tooltip="{{tip}}"{{/if}}>
            <i class="fa-solid {{#if ok}}fa-check{{else}}fa-xmark{{/if}}" aria-hidden="true"></i>
            <span class="pdvf-ideal-check-label">{{label}}</span>
            <span class="pdvf-ideal-check-value">{{value}}</span>
          </li>
          {{/each}}
        </ul>
        {{#if benefits.length}}
        <ul class="pdvf-ideal-benefits">
          {{#each benefits}}<li>{{this}}</li>{{/each}}
        </ul>
        {{/if}}
        <div class="pdvf-ideal-actions">
          {{#if canProtect}}<button type="button" class="pdvf-btn" data-action="idealProtect" data-ideal="{{id}}"><i class="fa-solid fa-shield-heart" aria-hidden="true"></i> {{localize "PDVF.Ideal.Protect"}}</button>{{/if}}
          {{#if canRevoke}}<button type="button" class="pdvf-btn" data-action="idealRevoke" data-ideal="{{id}}" data-tooltip="{{localize 'PDVF.Ideal.RevokeTip'}}">{{#if revoked}}{{localize "PDVF.Ideal.Restore"}}{{else}}{{localize "PDVF.Ideal.Revoke"}}{{/if}}</button>{{/if}}
        </div>
      </details>
      {{/each}}
      {{#if ideals.isGM}}{{#if ideals.editMode}}
      <div class="pdvf-ideal-gm">
        <label class="pdvf-check"><input type="checkbox" name="system.idealGM.wicked" {{checked ideals.wicked.enabled}}> {{localize "PDVF.Ideal.WickedAllow"}}</label>
        {{#if ideals.wicked.enabled}}
        <label class="pdvf-field"><span>{{localize "PDVF.Ideal.WickedBenefits"}}</span>
          <input type="text" name="system.idealGM.wickedBenefits" value="{{ideals.wicked.benefits}}" placeholder="{{localize 'PDVF.Ideal.WickedPlaceholder'}}"></label>
        {{/if}}
      </div>
      {{/if}}{{/if}}

      <h3 class="pdvf-h3">{{localize "PDVF.RoundTable.Title"}}</h3>
      {{#with ideals.roundTable}}
      {{#if member}}
      <p class="pdvf-round-table member"><i class="fa-solid fa-circle-dot" aria-hidden="true"></i> {{memberLine}}</p>
      <p class="pdvf-hint">{{benefits}}</p>
      {{else}}
      <ul class="pdvf-ideal-checks">
        <li class="{{#if noticed}}ok{{else}}missing{{/if}}" data-tooltip="{{localize 'PDVF.RoundTable.NoticedTip'}}">
          <i class="fa-solid {{#if noticed}}fa-check{{else}}fa-xmark{{/if}}" aria-hidden="true"></i>
          <span class="pdvf-ideal-check-label">{{#if courteous}}{{localize "PDVF.Ideal.courteous.name"}}{{else}}{{localize "PDVF.RoundTable.Glory"}}{{/if}}</span>
          <span class="pdvf-ideal-check-value">{{#if courteous}}✓{{else}}{{glory}} / {{gloryHint}}{{/if}}</span>
        </li>
        {{#each checks}}
        <li class="{{#if ok}}ok{{else}}missing{{/if}}">
          <i class="fa-solid {{#if ok}}fa-check{{else}}fa-xmark{{/if}}" aria-hidden="true"></i>
          <span class="pdvf-ideal-check-label">{{label}}</span>
          <span class="pdvf-ideal-check-value">{{value}}</span>
        </li>
        {{/each}}
      </ul>
      <p class="pdvf-hint">{{localize "PDVF.RoundTable.Hint"}}</p>
      {{#if canAdmit}}<button type="button" class="pdvf-btn" data-action="roundTableAdmit" data-tooltip="{{admitTip}}"><i class="fa-solid fa-circle-dot" aria-hidden="true"></i> {{localize "PDVF.RoundTable.Admit"}}</button>{{/if}}
      {{/if}}
      {{/with}}

      {{#with ideals.companions}}
      <h3 class="pdvf-h3">{{localize "PDVF.Companions.Title"}}</h3>
      {{#if member}}
      <p class="pdvf-round-table member"><i class="fa-solid fa-crown" aria-hidden="true"></i> {{memberLine}}</p>
      {{else}}
      <p class="pdvf-hint">{{count}} — <strong class="pdvf-companions-verdict {{verdictCls}}">{{verdict}}</strong></p>
      <ul class="pdvf-ideal-checks pdvf-companions-exam">
        {{#each rows}}
        <li class="{{cls}}"><span class="pdvf-ideal-check-label">{{label}}</span><span class="pdvf-ideal-check-value">{{value}}</span></li>
        {{/each}}
      </ul>
      <p class="pdvf-hint">{{localize "PDVF.Companions.Hint"}}</p>
      {{#if canAdmit}}<button type="button" class="pdvf-btn" data-action="companionsAdmit" data-tooltip="{{admitTip}}"><i class="fa-solid fa-crown" aria-hidden="true"></i> {{localize "PDVF.Companions.Admit"}}</button>{{/if}}
      {{/if}}
      {{/with}}
    </section>
  </div>

  <div class="pdvf-passions-col">
    <h2 class="pdvf-h2"><i class="pdvf-lozenge" aria-hidden="true"></i>{{localize "PDVF.Section.Passions"}}
      {{#if isGM}}<button type="button" class="pdvf-btn pdvf-newday" data-action="newDay" data-tooltip="{{localize 'PDVF.Invoke.NewDayTip'}}"><i class="fa-solid fa-sun" aria-hidden="true"></i> {{localize "PDVF.Invoke.NewDay"}}</button>{{/if}}
    </h2>

    <div class="pdvf-honor-row">
      <input type="checkbox" class="pdvf-xp" name="system.honor.xp" {{checked honor.xp}} aria-label="{{localize 'PDVF.Sheet.XpFor'}} {{localize 'PDVF.Honor'}}">
      {{#if editMode}}
      <span class="pdvf-row-label">{{localize "PDVF.Honor"}}</span>
      {{> "systems/pendragon-vf/templates/actor/chevalier/parts/stepper.hbs" name="system.honor.value" value=honor.value min="0" label=(localize "PDVF.Honor")}}
      {{else}}
      <button type="button" class="pdvf-row-roll" data-action="roll" data-key="honor">
        <span class="pdvf-row-label">{{localize "PDVF.Honor"}}{{#if honor.invoked}} <i class="fa-solid fa-sun pdvf-invoked" data-tooltip="{{localize 'PDVF.Invoke.UsedTodayTip'}}" aria-label="{{localize 'PDVF.Invoke.UsedToday'}}"></i>{{/if}}</span>
        <span class="pdvf-level">{{honor.levelLabel}}</span>
        <i class="pdvf-die-icon" aria-hidden="true"></i>
        <span class="pdvf-row-value">{{honor.display}}</span>
      </button>
      {{/if}}
    </div>

    <div class="pdvf-courts {{#if editMode}}editing{{/if}}">
      {{#each courts}}
      <section class="pdvf-court">
        <h3 class="pdvf-court-title">
          <span>{{label}}</span>
          <span class="pdvf-court-total {{#if over}}over{{/if}}" data-tooltip="{{localize 'PDVF.Sheet.CourtTip'}}">{{total}} / {{max}}</span>
        </h3>
        {{#each passions}}
        <div class="pdvf-row level-{{level}}">
          <input type="checkbox" class="pdvf-xp" name="system.passions.{{index}}.xp" {{checked xp}} aria-label="{{localize 'PDVF.Sheet.XpFor'}} {{name}}">
          {{#if @root.editMode}}
          <input type="text" class="pdvf-row-text" name="system.passions.{{index}}.name" value="{{name}}" aria-label="{{localize 'PDVF.Sheet.PassionName'}}">
          {{> "systems/pendragon-vf/templates/actor/chevalier/parts/stepper.hbs" name=(concat "system.passions." index ".value") value=value min="0" label=name}}
          <button type="button" class="pdvf-icon-btn" data-action="deleteRow" data-path="system.passions" data-index="{{index}}" aria-label="{{localize 'PDVF.Sheet.Delete'}}">×</button>
          {{else}}
          <button type="button" class="pdvf-row-roll" data-action="roll" data-key="{{key}}">
            <span class="pdvf-row-label">{{name}}{{#if invoked}} <i class="fa-solid fa-sun pdvf-invoked" data-tooltip="{{localize 'PDVF.Invoke.UsedTodayTip'}}" aria-label="{{localize 'PDVF.Invoke.UsedToday'}}"></i>{{/if}}</span>
            <i class="pdvf-die-icon" aria-hidden="true"></i>
            <span class="pdvf-row-value">{{display}}</span>
          </button>
          {{/if}}
        </div>
        {{else}}
        <p class="pdvf-hint">{{localize "PDVF.Sheet.NoPassion"}}</p>
        {{/each}}
        {{#if @root.editMode}}
        <button type="button" class="pdvf-btn pdvf-add" data-action="addRow" data-path="system.passions" data-court="{{court}}">{{localize "PDVF.Sheet.AddPassion"}}</button>
        {{/if}}
      </section>
      {{/each}}
    </div>

    {{!-- Vie de cour (Livre du maître, chap. 3) --}}
    {{#with court}}
    <section class="pdvf-court-life">
      <h2 class="pdvf-h2"><i class="pdvf-lozenge" aria-hidden="true"></i>{{localize "PDVF.Court.Title"}}</h2>

      <div class="pdvf-court-eng">
        <div class="pdvf-court-eng-value" data-tooltip="{{localize 'PDVF.Court.EngouementTip'}}"><span>{{localize "PDVF.Feast.Engouement"}}</span><strong>{{engouement}}</strong></div>
        <div class="pdvf-court-eng-parts">
          <span>{{localize "PDVF.Feast.Start"}} {{start}}{{#if romantic}} <i class="fa-solid fa-heart" data-tooltip="{{localize 'PDVF.Feast.RomanticTip'}}"></i>{{/if}}</span>
          <span>{{localize "PDVF.Court.AtCourt"}} {{adjustLabel}}
            <button type="button" class="pdvf-icon-btn" data-action="court" data-op="adjust" data-value="-1" aria-label="−1">−</button><button type="button" class="pdvf-icon-btn" data-action="court" data-op="adjust" data-value="1" aria-label="+1">+</button><button type="button" class="pdvf-icon-btn" data-action="court" data-op="adjust" data-value="reset" data-tooltip="{{localize 'PDVF.Court.NewCourt'}}"><i class="fa-solid fa-rotate-left"></i></button></span>
          {{#if @root.editMode}}<label class="pdvf-inline">{{localize "PDVF.Court.Other"}} <input class="pdvf-num" type="number" name="system.court.other" value="{{other}}" step="1"></label>{{/if}}
        </div>
        <button type="button" class="pdvf-btn pdvf-mini" data-action="court" data-op="test"><i class="fa-solid fa-dice-d20"></i> {{localize "PDVF.Court.Test"}}</button>
      </div>
      <p class="pdvf-hint">{{#if fashionLine}}{{fashionLine}}{{else}}{{localize "PDVF.Court.Fashion.None"}}{{/if}}
        <button type="button" class="pdvf-btn pdvf-mini" data-action="court" data-op="fashion"><i class="fa-solid fa-shirt"></i> {{localize "PDVF.Court.Fashion.Title"}}</button></p>

      <h3 class="pdvf-h3">{{localize "PDVF.Court.Love.Title"}}</h3>
      {{#with love}}
      {{#if adoration}}
      <p>{{adoration.name}} <strong>{{adoration.value}}</strong>{{#if consummated}} · <span class="pdvf-tag">{{localize "PDVF.Court.Love.ConsummatedTag"}}</span>{{/if}}{{#if raisedThisYear}} · <span class="pdvf-hint-inline">{{localize "PDVF.Court.Love.RaisedThisYear"}}</span>{{/if}}</p>
      <div class="pdvf-inline">
        {{#unless consummated}}<button type="button" class="pdvf-btn pdvf-mini" data-action="court" data-op="gift" data-tooltip="{{localize 'PDVF.Court.Love.GiftHint'}}"><i class="fa-solid fa-gift"></i> {{localize "PDVF.Court.Love.Gift"}}</button>
        <button type="button" class="pdvf-btn pdvf-mini" data-action="court" data-op="consummate">{{localize "PDVF.Court.Love.Consummate"}}</button>{{/unless}}
      </div>
      {{#if gifts.length}}<ul class="pdvf-court-list">{{#each gifts}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
      {{else}}
      <p class="pdvf-hint">{{#if consummated}}{{beloved}} · {{localize "PDVF.Court.Love.ConsummatedTag"}}{{else}}{{localize "PDVF.Court.Love.None"}}{{/if}}</p>
      {{/if}}
      {{/with}}
      <button type="button" class="pdvf-btn pdvf-mini" data-action="court" data-op="love"><i class="fa-solid fa-heart"></i> {{localize "PDVF.Court.Love.Start"}}</button>

      <h3 class="pdvf-h3">{{localize "PDVF.Court.Seduce.Title"}}</h3>
      {{#each seductions}}
      <div class="pdvf-court-seduction status-{{status}}">
        <p><strong>{{name}}</strong> <span class="pdvf-hint-inline">{{kindLabel}}{{#if married}} · {{localize "PDVF.Court.Seduce.MarriedShort"}}{{/if}}</span>{{#if statusLabel}} · <span class="pdvf-tag">{{statusLabel}}</span>{{/if}}</p>
        {{#if noble}}<p class="pdvf-hint-inline">{{localize "PDVF.Court.Seduce.Favors"}} : F{{total}}{{#if favorsText}} — {{favorsText}}{{/if}}</p>{{/if}}
        <div class="pdvf-inline">
          {{#unless status}}
            {{#if noble}}<button type="button" class="pdvf-btn pdvf-mini" data-action="court" data-op="favor" data-id="{{id}}">{{localize "PDVF.Court.Seduce.AddFavor"}}</button>
            {{else}}<button type="button" class="pdvf-btn pdvf-mini" data-action="court" data-op="seduce" data-id="{{id}}"><i class="fa-solid fa-dice-d20"></i> {{localize "PDVF.Court.Seduce.Try"}}</button>{{/if}}
          {{/unless}}
          {{#if @root.court.isGM}}
            {{#if noble}}<label class="pdvf-inline pdvf-gm-only" data-tooltip="{{localize 'PDVF.Court.Seduce.ThresholdTip'}}"><i class="fa-solid fa-eye-slash"></i> {{localize "PDVF.Court.Seduce.Threshold"}} <input class="pdvf-num" type="number" data-court-threshold="{{id}}" value="{{threshold}}" min="0" step="1"></label>{{#if reached}}<span class="pdvf-tag pdvf-tag-warn">{{localize "PDVF.Court.Seduce.ReachedTag"}}</span>{{/if}}{{/if}}
            <button type="button" class="pdvf-btn pdvf-mini" data-action="court" data-op="status" data-id="{{id}}" data-value="seduced">{{localize "PDVF.Court.Seduce.Status.seduced"}}</button>
            <button type="button" class="pdvf-btn pdvf-mini" data-action="court" data-op="status" data-id="{{id}}" data-value="discovered">{{localize "PDVF.Court.Seduce.Status.discovered"}}</button>
          {{/if}}
          <button type="button" class="pdvf-icon-btn" data-action="court" data-op="status" data-id="{{id}}" data-value="remove" aria-label="{{localize 'PDVF.Sheet.Delete'}}">×</button>
        </div>
      </div>
      {{/each}}
      <button type="button" class="pdvf-btn pdvf-mini" data-action="court" data-op="seductionAdd">{{localize "PDVF.Court.Seduce.Add"}}</button>

      <h3 class="pdvf-h3">{{localize "PDVF.Court.Drink.Title"}}</h3>
      {{#with drink}}
      <p>{{localize "PDVF.Court.Drink.Now"}} : <strong>{{label}}</strong>{{#if skillsNote}} · <span class="pdvf-hint-inline">{{localize "PDVF.Court.Drink.SkillsNote"}} {{skillsNote}}</span>{{/if}}{{#if immune}} · <span class="pdvf-hint-inline">{{localize "PDVF.Court.Drink.ImmuneTip"}}</span>{{/if}}{{#if hangover}} · <span class="pdvf-tag pdvf-tag-warn">{{localize "PDVF.Court.Drink.State.hangover"}}</span>{{/if}}</p>
      <div class="pdvf-inline">
        <button type="button" class="pdvf-btn pdvf-mini" data-action="court" data-op="drink"><i class="fa-solid fa-wine-glass"></i> {{localize "PDVF.Court.Drink.Drink"}}</button>
        {{#unless sober}}<button type="button" class="pdvf-btn pdvf-mini" data-action="court" data-op="awake" data-tooltip="{{localize 'PDVF.Court.Drink.AwakeTip'}}">{{localize "PDVF.Court.Drink.Awake"}}</button>
        <button type="button" class="pdvf-btn pdvf-mini" data-action="court" data-op="sober">{{localize "PDVF.Court.Drink.Sober"}}</button>{{/unless}}
        {{#if hangoverPending}}<button type="button" class="pdvf-btn pdvf-mini pdvf-btn-primary" data-action="court" data-op="hangover">{{localize "PDVF.Court.Drink.Hangover"}}</button>{{/if}}
      </div>
      {{/with}}
    </section>
    {{/with}}
  </div>
</section>
