<div class="pdvf-card pdvf-duel-card">
  <header class="pdvf-card-header">
    <h3 class="pdvf-card-title"><i class="fa-solid fa-hand-fist" aria-hidden="true"></i> {{title}}</h3>
    <div class="pdvf-card-subtitle">{{stakes}}</div>
  </header>
  <p class="pdvf-battle-text">{{status}}</p>
  <div class="pdvf-card-buttons"><button type="button" data-pdvf-duel="open">{{#if challenge}}{{localize "PDVF.Duel.Answer"}}{{else}}{{localize "PDVF.Duel.Open"}}{{/if}}</button></div>
</div>
