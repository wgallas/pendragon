<span class="pdvf-wiz-stepper">
  <button type="button" class="pdvf-step" data-action="inc" data-path="{{path}}" data-delta="-1" data-min="{{#if min}}{{min}}{{else}}0{{/if}}"{{#if max}} data-max="{{max}}"{{else if (lookup @root.caps path)}} data-max="{{lookup @root.caps path}}"{{/if}} aria-label="{{localize 'PDVF.Sheet.Decrease'}} {{label}}">−</button>
  <span class="pdvf-wiz-stepper-value">{{value}}</span>
  <button type="button" class="pdvf-step" data-action="inc" data-path="{{path}}" data-delta="1" data-min="{{#if min}}{{min}}{{else}}0{{/if}}"{{#if max}} data-max="{{max}}"{{else if (lookup @root.caps path)}} data-max="{{lookup @root.caps path}}"{{/if}} aria-label="{{localize 'PDVF.Sheet.Increase'}} {{label}}">+</button>
</span>
